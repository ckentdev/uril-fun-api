APP_NAME="AI Integration Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# SPA origin: used for CORS, redirects and email links
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# Local dev: run Mailpit (docs/EMAIL_SETUP.md) and use MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google OAuth (requires Google Cloud credentials; see docs/GOOGLE_AUTH.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/auth/google/callback"

# --- AI provider (mock works with no credentials; see docs/AI_SETUP.md) ---
# AI_PROVIDER: mock | repohive | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# RepoHive Cloud AI (AI_PROVIDER=repohive; AI_API_KEY is the hbc_ai_... key)
AI_REPOHIVE_URL=https://apicloud.repohive.com/api
# Server-wide fallback knowledge. Users edit their own on the AI Knowledge page, which takes precedence.
AI_KNOWLEDGE=
AI_KNOWLEDGE_MAX_CHARS=20000
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_SYSTEM_PROMPT="You are a helpful assistant for enrollment process at tagoloan community college."
AI_HISTORY_LIMIT=20
AI_MAX_INPUT_CHARS=4000

# --- Demo limits ---
EMAIL_DAILY_LIMIT=20
EMAIL_ALLOWED_DOMAINS=
RATE_LIMIT_EMAIL=3
RATE_LIMIT_AI=20
RATE_LIMIT_CHAT=20
LOG_RETENTION_DAYS=30

# --- Production checklist (set these when deploying; see docs/INSTALLATION.md) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SANCTUM_STATEFUL_DOMAINS=app.example.com
# SESSION_DOMAIN=.example.com        # shared parent domain so the SPA and API share cookies
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
